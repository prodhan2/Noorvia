<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_ramadan_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="#1A2744">
    <TextView android:id="@+id/widget_ramadan_title" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="রমজান" android:textColor="#F5C842"
        android:textStyle="bold" android:textSize="17sp" />
    <TextView android:id="@+id/widget_ramadan_status" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="অফলাইন সময় প্রস্তুত থাকবে"
        android:textColor="#C6CFDE" android:textSize="10sp" android:layout_marginTop="2dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="10dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/widget_sehri_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="সেহরি শেষ" android:textColor="#C6CFDE" android:textSize="11sp" />
            <TextView android:id="@+id/widget_sehri_time" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="05:10" android:textColor="#FFFFFF"
                android:textStyle="bold" android:textSize="18sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="end">
            <TextView android:id="@+id/widget_iftar_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ইফতার" android:textColor="#C6CFDE" android:textSize="11sp" />
            <TextView android:id="@+id/widget_iftar_time" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="18:20" android:textColor="#FFFFFF"
                android:textStyle="bold" android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/widget_ramadan_location" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="📍 ঢাকা" android:textColor="#8FA2C3"
        android:textSize="10sp" android:layout_marginTop="8dp" />
</LinearLayout>
